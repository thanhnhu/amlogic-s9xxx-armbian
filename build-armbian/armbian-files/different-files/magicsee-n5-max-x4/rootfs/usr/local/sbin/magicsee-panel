#!/bin/sh
# Front panel (FD6551) of the Magicsee N5 Max X4: clock with a blinking colon.
#
# The tm16xx driver built into the devmfc kernels does not read a segment map
# from the device tree, so this box's map is written to sysfs first: map6 of
# devmfc's tm16xx-map.sh (4 digits on bytes 1..4, bits 3 4 5 0 1 2 6) with the
# colon moved from byte 0 bit 1 (the USB icon on this panel) to bit 4 (0x04).
# Show something else meanwhile:  echo "1234" > /sys/bus/platform/drivers/tm16xx/*/digits

MAP="13 14 15 10 11 12 16 ff 23 24 25 20 21 22 26 ff 33 34 35 30 31 32 36 ff 43 44 45 40 41 42 46 ff ff 05 06 ff ff ff ff ff 04 02 03 ff ff ff ff ff"
# The colon is driven through the digits string ("HHMM+COLON" / "HHMM-COLON"), as in
# devmfc's tm16xx-display.

dev=""
for _ in $(seq 1 30); do
    dev=$(dirname /sys/bus/platform/drivers/tm16xx/*/digits 2>/dev/null)
    [ -d "$dev" ] && break
    sleep 1
done
[ -d "$dev" ] || { echo "magicsee-panel: no tm16xx device" >&2; exit 0; }

echo "$MAP" > "$dev/mapping"
echo 7 > "$dev/brightness"

clear_panel() { echo "" > "$dev/digits"; exit 0; }
trap clear_panel TERM INT

on=0
while :; do
    if [ "$on" = 1 ]; then sign="+"; else sign="-"; fi
    echo "$(date +%H%M)${sign}COLON" > "$dev/digits"
    on=$((1 - on))
    sleep 1
done
